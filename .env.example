PROD=false
PORT=6001
DB_VERSION=version_007
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hubsme
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=connection_str
AZURE_CONTAINER_NAME=name

# Microsoft Teams mediante Microsoft Graph
TEAMS_MEETINGS_ENABLED=false

# Microsoft Graph
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Microsoft teams
MS_GRAPH_TEAMS_ORGANIZER_USER_ID=

# Microsoft Email
MS_GRAPH_SENDER_EMAIL=

# Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:6001/auth/google/callback

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:6001/admin/consultant-google-calendar/callback

# Mercado Pago marketplace / Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_CURRENCY=PEN
MERCADO_PAGO_PLATFORM_FEE_PERCENT=4
MERCADO_PAGO_REDIRECT_URI=http://localhost:6001/admin/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_URL=http://localhost:6001/admin/mercado-pago/webhook

# Gemini IA
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash-lite

# PeruDevs - validación de identidad por DNI
PERUDEVS_API_KEY=

# Internal administrative panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Meeting reminders
MEETING_REMINDER_MINUTES_BEFORE=15
MEETING_REMINDER_MAX_ATTEMPTS=3

# Back
BACKEND_URL=http://localhost:6001

# Front
FRONTEND_URL=http://localhost:6200

# Monnet Payin - Create Transaction (Swagger: etiqueta monnetPayin)
# cert: https://cert.monnetpayments.com; production: https://payin.api.monnetpayments.com.
MONNET_PAYIN_ENVIRONMENT=cert
# Merchant ID y KeyMonnet del MISMO entorno, entregados por Monnet. La Key permanece solo en backend.
MONNET_PAYIN_MERCHANT_ID=
MONNET_PAYIN_KEY=
# Moneda por defecto si el DTO no envía payinCurrency: PEN o USD.
MONNET_PAYIN_CURRENCY=PEN
# Reemplazar por las URLs HTTPS de retorno de tu comercio, hasta 250 caracteres.
MONNET_PAYIN_SUCCESS_URL=https://example.com/monnet/success
MONNET_PAYIN_ERROR_URL=https://example.com/monnet/error
# Minutos de vigencia por defecto (Monnet sugiere 30 para banca por internet).
MONNET_PAYIN_EXPIRATION_MINUTES=30
# Tiempo máximo total de creación; no hay reintento automático de un POST.
MONNET_PAYIN_REQUEST_TIMEOUT_MS=15000

# Checkout de reuniones: comisión contable de Hubsme (porcentaje, 0 <= valor < 100).
# Se descuenta del importe pendiente del consultor; no representa la comisión de Monnet.
MONNET_PLATFORM_FEE_PERCENT=4
